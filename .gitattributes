# 换行统一 LF，避免 Windows 下检出后被 CRLF 污染
* text=auto eol=lf

*.md            text eol=lf
*.lua           text eol=lf
.txt            text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# ─── 二进制资产：交给 Git LFS ──────────────────────────────────────────────
# 这些扩展名一旦提交就走 LFS。注意：clone 端必须装 git-lfs，
# 否则拿到的是一百多字节的指针文件，不是内容。
*.bundle    filter=lfs diff=lfs merge=lfs -text
*.unity3d   filter=lfs diff=lfs merge=lfs -text
*.cab       filter=lfs diff=lfs merge=lfs -text
*.bytes     filter=lfs diff=lfs merge=lfs -text
*.luac      filter=lfs diff=lfs merge=lfs -text
*.7z        filter=lfs diff=lfs merge=lfs -text
*.zip       filter=lfs diff=lfs merge=lfs -text
*.rar       filter=lfs diff=lfs merge=lfs -text

# 图片：小文件不值得走 LFS，但别让 git 当文本处理
*.png      binary
*.jpg      binary
*.webp     binary
*.gif      binary
